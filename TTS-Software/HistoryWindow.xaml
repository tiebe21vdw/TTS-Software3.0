<Window x:Class="TTS_Software.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geschiedenis"
        Width="400"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Geschiedenis" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyStateText"
                       Text="Nog geen voorgelezen tekst. Selecteer iets met het eerste icoontje om te beginnen."
                       TextWrapping="Wrap" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed" />

            <ListBox x:Name="HistoryListBox" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" CornerRadius="8" Background="#12000000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Opacity="0.55" Margin="0,3,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="&#9654;" Width="30" Height="30" Margin="6,0,0,0"
                                        ToolTip="Opnieuw voorlezen" Click="ReplayButton_Click" />
                                <Button Grid.Column="2" Content="&#128465;" Width="30" Height="30" Margin="6,0,0,0"
                                        ToolTip="Verwijderen" Click="DeleteButton_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Wis alles" Width="90" Margin="0,0,8,0" Click="ClearAllButton_Click" />
            <Button Content="Sluiten" Width="90" IsDefault="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
