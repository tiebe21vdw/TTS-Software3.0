<Window x:Class="TTS_Software.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow" Height="50" Width="50"
        x:Name="MijnVenster"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">
    
    <!-- CRUCIALE AANPASSING: Background="#01000000" (bijna 100% transparant zwart) 
         Dit zorgt ervoor dat de lege ruimte tussen de icons ook muisbewegingen registreert! -->
    <Grid Background="{DynamicResource HitTestBackgroundBrush}">
        
        <!-- De Lay-out Container -->
        <Grid Background="Transparent" Height="50" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            
            <Grid.RenderTransform>
                <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            
            <Grid.Triggers>
                <!-- 1. STARTUP TRIGGER -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BorderRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="IconRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="IconRotation2" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="CenterIconRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="OffIconRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- 2. MOUSE ENTER TRIGGER -->
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.23"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.23"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- 3. MOUSE LEAVE TRIGGER -->
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.23"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GridScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.23"><DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- De eerste border -->
            <Border x:Name="EersteBorder" Background="{DynamicResource PanelBrush}" Width="40" Height="40" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top">

                <Border.RenderTransform>
                    <TranslateTransform Y="5" />
                </Border.RenderTransform>

                <!-- De cirkel met de magische draaiende rand -->
                <Ellipse IsHitTestVisible="False" Width="25" Height="25" StrokeThickness="2.5" 
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="BorderRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                            <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                            <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <!-- <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource OuterFillStartColor}" Offset="0.0" />
                            <GradientStop Color="{DynamicResource OuterFillEndColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Ellipse.Fill> -->
                </Ellipse>
            </Border>
        </Grid>
        
        <!-- 1e container met het icoon (TTS: tekst selecteren en voorlezen) -->
        <Border x:Name="TtsKnop" Width="30" Height="30" CornerRadius="10"
            ToolTip="Tekst voorlezen — klik, of Ctrl+Alt+L"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            MouseLeftButtonDown="TtsKnop_MouseLeftButtonDown"
            MouseLeftButtonUp="TtsKnop_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform Y="55" />
            </Border.RenderTransform>
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- De 2de border verschijnt zodra de muis over het totale Venster (50x200px) beweegt -->
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MijnVenster}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Path Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12h12v-12C24,5.383,18.617,0,12,0Zm10,22h-10c-5.514,0-10-4.486-10-10S6.486,2,12,2s10,4.486,10,10v10Zm-8.5-10c0,.828-.672,1.5-1.5,1.5s-1.5-.672-1.5-1.5.672-1.5,1.5-1.5,1.5.672,1.5,1.5Zm5,0c0,.828-.672,1.5-1.5,1.5s-1.5-.672-1.5-1.5.672-1.5,1.5-1.5,1.5.672,1.5,1.5Zm-10,0c0,.828-.672,1.5-1.5,1.5s-1.5-.672-1.5-1.5.672-1.5,1.5-1.5,1.5.672,1.5,1.5Z" 
                      Width="16" 
                      Height="16"
                      Stretch="Fill">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="IconRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                            <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                            <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Klein groen lampje dat oplicht zolang er wordt voorgelezen -->
                <Ellipse x:Name="SpeakingIndicator" Width="7" Height="7" Fill="#FF4CD964"
                         Stroke="#FF18181B" StrokeThickness="1"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-6,-6,0" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- 2e container met het icoon: Geschiedenis (eerder voorgelezen fragmenten) -->
        <Border x:Name="GeschiedenisKnop" Width="30" Height="30" CornerRadius="10"
            ToolTip="Geschiedenis"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            MouseLeftButtonDown="GeschiedenisKnop_MouseLeftButtonDown"
            MouseLeftButtonUp="GeschiedenisKnop_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform Y="95" />
            </Border.RenderTransform>

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MijnVenster}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.19"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.19"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Eenvoudig "lijst"-icoontje: drie balkjes -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Resources>
                    <LinearGradientBrush x:Key="HistoryIconBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </StackPanel.Resources>
                <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,3" Fill="{StaticResource HistoryIconBrush}" />
                <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Margin="0,0,0,3" Fill="{StaticResource HistoryIconBrush}" />
                <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Fill="{StaticResource HistoryIconBrush}" />
            </StackPanel>
        </Border>

        <!-- 3e container met het icoon -->
        <Border x:Name="InstellingenKnop" Width="30" Height="30" CornerRadius="10"
            ToolTip="Instellingen"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            MouseLeftButtonDown="InstellingenKnop_MouseLeftButtonDown"
            MouseLeftButtonUp="InstellingenKnop_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform Y="135" />
            </Border.RenderTransform>
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- De 2de border verschijnt zodra de muis over het totale Venster (50x200px) beweegt -->
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MijnVenster}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.23"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.23"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Path Data="M3.082 13.945c-.529-.95-.793-1.426-.793-1.945c0-.519.264-.994.793-1.944L4.43 7.63l1.426-2.381c.559-.933.838-1.4 1.287-1.66c.45-.259.993-.267 2.08-.285L12 3.26l2.775.044c1.088.018 1.631.026 2.08.286c.45.26.73.726 1.288 1.659L19.57 7.63l1.35 2.426c.528.95.792 1.425.792 1.944c0 .519-.264.994-.793 1.944L19.57 16.37l-1.426 2.381c-.559.933-.838 1.4-1.287 1.66c-.45.259-.993.267-2.08.285L12 20.74l-2.775-.044c-1.088-.018-1.631-.026-2.08-.286c-.45-.26-.73-.726-1.288-1.659L4.43 16.37z" 
                    Width="18" 
                    Height="16" 
                    Stretch="Fill"
                    Fill="Transparent"
                    StrokeThickness="1.6">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="IconRotation2" CenterX="0.5" CenterY="0.5" Angle="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Stroke>
                </Path>

                <Ellipse Width="5" Height="5" Fill="Transparent" StrokeThickness="1.6"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="CenterIconRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                            <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                            <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
            </Grid>
        </Border>
                <Border x:Name="OffKnop" Width="30" Height="30" CornerRadius="10"
                ToolTip="Afsluiten"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MouseLeftButtonDown="OffKnop_MouseLeftButtonDown"
                MouseLeftButtonUp="OffKnop_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TranslateTransform Y="175" />
            </Border.RenderTransform>
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TransparentBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- De 2de border verschijnt zodra de muis over het totale Venster (50x200px) beweegt -->
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MijnVenster}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.20"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Path Data="M512 1024q-139 0-257-68.5T68.5 769T0 512q0-97 34.5-185T132 170q3-3 11.5-12t14-14.5t15-10.5t19.5-5q26 0 45 19t19 45q0 16-3.5 28t-7.5 16l-3 5q-54 53-84 123t-30 148q0 104 51.5 192.5t140 140T512 896t192.5-51.5t140-140T896 512q0-78-30-148.5T783 240q-15-15-15-48q0-26 19-45t45-19q7 0 13.5 2t10.5 4t10.5 8t8.5 8.5t9 10.5t8 9q63 69 97.5 157t34.5 185q0 104-40.5 199t-109 163.5t-163.5 109t-199 40.5zm0-512q-27 0-45.5-18.5T448 448V64q0-27 19-45.5T512.5 0t45 18.5T576 64v384q0 27-18.5 45.5T512 512z" 
                  Width="16" 
                  Height="16"
                  Stretch="Fill">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="OffIconRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource SecondaryColor}" Offset="0.5" />
                        <GradientStop Color="{DynamicResource HighlightColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Border>
    </Grid>
</Window> 