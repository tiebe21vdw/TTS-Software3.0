<Window x:Class="TTS_Software.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecteer tekst"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        Loaded="Window_Loaded">
    <Grid>
        <!-- Donkere waas over het hele scherm, zodat duidelijk is dat je in selectiemodus zit -->
        <Rectangle Fill="#55000000" />

        <!-- Het gebied dat je aan het slepen bent -->
        <Canvas>
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Stroke="White"
                       StrokeThickness="1.5"
                       Fill="#22FFFFFF" />
        </Canvas>

        <TextBlock Text="Sleep om een gebied te selecteren  ·  Esc om te annuleren"
                   Foreground="White"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Opacity="0.85" />
    </Grid>
</Window>
